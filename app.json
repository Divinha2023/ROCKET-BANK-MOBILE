{
  "expo": {
    "name": "rocket-bank-mobile",
    "slug": "rocket-bank-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/rocketbank-icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#05010F"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/rocketbank-adaptive-icon.png",
        "backgroundColor": "#05010F"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/rocketbank-favicon.png"
    }
  }
}
